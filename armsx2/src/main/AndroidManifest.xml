<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application android:largeHeap="true">

        <meta-data android:name="android.app.game_mode" android:value="performance" />

        <activity
            android:name="com.armsx2.Main"
            android:process=":ps2"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|navigation|density"
            android:screenOrientation="sensorLandscape"
            android:hardwareAccelerated="true"
            android:exported="false"
            android:theme="@style/Theme.ARMSX2" />

        <activity-alias
            android:name="com.armsx2.MainActivity"
            android:exported="false"
            android:targetActivity="com.armsx2.Main" />

        <receiver
            android:name="com.armsx2.RetroAchievementsHostOverrideReceiver"
            android:exported="false" />
    </application>
</manifest>
