<?xml version="1.0" encoding="utf-8"?>
    <!-- Single source of truth for the app's XML-resource color tokens (legacy View
         system; Compose uses shared/theme/WinNativeTheme.kt instead — Android requires
         separate files per system, but each system now has exactly one).
         Dark tokens below are the real in-app palette: true/solid black surfaces with
         one saturated orange accent, no warm brown tint. Light tokens are kept only for
         AppTheme (still referenced from the manifest) and are otherwise unused. -->
<resources>
    
    <color name="window_background_color">#fafafa</color>
    <color name="colorPrimary">#3A2A1E</color>
    <color name="colorPrimaryDark">#1A1210</color>
    <color name="colorAccent">#FF7A00</color>


    <color name="window_background_color_dark">#000000</color>
    <color name="colorPrimaryDarkMode">#0D0D0D</color>
    <color name="colorPrimaryDarkModeDark">#000000</color>
    <color name="colorAccentDark">#FF9500</color>
    <color name="white">#ffffff</color>

    
    <color name="control_editor_background">#000000</color>
    <color name="settings_card_surface">#0D0D0D</color>
    <color name="settings_outline">#262626</color>
    <color name="settings_chip_selected_stroke">#FFA940</color>
    <color name="settings_text_primary">#FBF3EC</color>
    <color name="settings_text_secondary">#C7A88F</color>
    <color name="settings_icon_tint">#F2DFCC</color>
    <color name="settings_action_surface">#000000</color>
    <color name="settings_action_surface_pressed">#262626</color>
    <color name="settings_accent">#FF7A00</color>
    <color name="settings_popup_surface">#0D0D0D</color>
    <color name="settings_popup_surface_edge">#262626</color>
    <color name="settings_input_outline_soft">#52FBF3EC</color>

</resources>
